# Copy this file to ".env" and fill in real values.

# --- Claude (Anthropic) ---
# Get a key at https://console.anthropic.com/ → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- MySQL (from hPanel → Databases) ---
# Leave these blank for local AI-only mode (no question cache).
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Optional ---
# Port the Node server listens on (Hostinger sets this automatically).
# PORT=300x
# FULLTEXT relevance score a fuzzy match must beat (higher = stricter).
# MATCH_THRESHOLD=4
