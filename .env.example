# Copy this file to ".env" and fill in real values.

# --- Claude (Anthropic) ---
# Get a key at https://console.anthropic.com/ → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override for the portfolio chatbot.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenAI fallback (server only; never use a VITE_ prefix for API keys) ---
# Add a real API key in your hosting environment or local .env file.
# Used if Anthropic is missing, fails, times out, or returns no complete answer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- MySQL (from Hostinger hPanel → Databases) ---
# Leave these blank for local AI-only mode (no question cache).
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Optional ---
# Port the Node server listens on (Hostinger sets this automatically).
# PORT=3001
# FULLTEXT relevance score a fuzzy match must beat (higher = stricter).
# MATCH_THRESHOLD=4
